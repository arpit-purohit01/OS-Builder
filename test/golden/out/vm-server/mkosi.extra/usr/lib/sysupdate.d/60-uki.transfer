[Transfer]
ProtectVersion=%A

[Source]
Type=regular-file
Path=/var/lib/foundry/staging
MatchPattern=ci-server_@v.efi

[Target]
Type=regular-file
Path=/EFI/Linux
PathRelativeTo=boot
MatchPattern=ci-server_@v+@l-@d.efi ci-server_@v+@l.efi ci-server_@v.efi
Mode=0444
TriesLeft=3
TriesDone=0
InstancesMax=2
