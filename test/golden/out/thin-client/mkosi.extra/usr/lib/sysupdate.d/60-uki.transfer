[Transfer]
ProtectVersion=%A

[Source]
Type=regular-file
Path=/var/lib/foundry/staging
MatchPattern=desk-terminal_@v.efi

[Target]
Type=regular-file
Path=/EFI/Linux
PathRelativeTo=boot
MatchPattern=desk-terminal_@v+@l-@d.efi desk-terminal_@v+@l.efi desk-terminal_@v.efi
Mode=0444
TriesLeft=3
TriesDone=0
InstancesMax=2
