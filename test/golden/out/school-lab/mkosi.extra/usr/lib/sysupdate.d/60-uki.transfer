[Transfer]
ProtectVersion=%A

[Source]
Type=regular-file
Path=/var/lib/foundry/staging
MatchPattern=campus-lab_@v.efi

[Target]
Type=regular-file
Path=/EFI/Linux
PathRelativeTo=boot
MatchPattern=campus-lab_@v+@l-@d.efi campus-lab_@v+@l.efi campus-lab_@v.efi
Mode=0444
TriesLeft=3
TriesDone=0
InstancesMax=2
