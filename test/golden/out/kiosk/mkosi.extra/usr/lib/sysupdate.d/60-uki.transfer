[Transfer]
ProtectVersion=%A

[Source]
Type=regular-file
Path=/var/lib/foundry/staging
MatchPattern=lobby-kiosk_@v.efi

[Target]
Type=regular-file
Path=/EFI/Linux
PathRelativeTo=boot
MatchPattern=lobby-kiosk_@v+@l-@d.efi lobby-kiosk_@v+@l.efi lobby-kiosk_@v.efi
Mode=0444
TriesLeft=3
TriesDone=0
InstancesMax=2
